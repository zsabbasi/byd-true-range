# systemd unit for a SHARED BYD range server (several people, each with their own BYD account) on Linux.
# Install: see deploy/README.md. Paths assume the app is in /opt/byd-range and runs as the user "byd-range".

[Unit]
Description=BYD range app, shared server (web app + one poller per person)
Documentation=file:///opt/byd-range/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=byd-range
Group=byd-range
WorkingDirectory=/opt/byd-range/cloud
ExecStart=/opt/byd-range/cloud/.venv/bin/python run.py --multi-user --max-users 10
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Optional: BYD_APP_INVITE=<a code people must enter to sign up>. Keep it in this root-owned file (chmod 600), not in this unit.
EnvironmentFile=-/etc/byd-range/shared.env

# Everyone's data lives here, one private folder per person: history, their encrypted BYD sign-in, settings (service user only, mode 0700).
Environment=BYD_DATA_DIR=/var/lib/byd-range
StateDirectory=byd-range
StateDirectoryMode=0700
UMask=0077

# The key that encrypts the stored BYD sign-in. It stays in a root-owned file and is handed to the service privately as
# $CREDENTIALS_DIRECTORY/byd_credential_key, so it is NOT in the data folder and other users cannot read it.
LoadCredential=byd_credential_key:/etc/byd-range/credential.key

# Hardening. The app only needs to talk to the network (BYD, and the local web server) and write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

# One small poller process per person: bound them so a mistake cannot take the machine down.
TasksMax=200
MemoryMax=1G

[Install]
WantedBy=multi-user.target
